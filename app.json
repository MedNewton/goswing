{
  "expo": {
    "name": "goswing",
    "slug": "goswing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash_goswing.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B15"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goswing.app",
      "splash": {
        "image": "./assets/splash_goswing.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0B15"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoSwing uses your location to show nearby events and experiences."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAElJiLEaPb1Qg-XjzE8WmjuxrQJkFsw4w"
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.themoorishdev.goswing",
      "splash": {
        "image": "./assets/splash_goswing.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0B15"
      },
      "backgroundColor": "#0B0B15",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAElJiLEaPb1Qg-XjzE8WmjuxrQJkFsw4w"
        }
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B15",
          "image": "./assets/splash_goswing.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash_goswing.png",
            "imageWidth": 280,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0cadf90f-07f5-463f-9804-023438b6cdc5"
      },
